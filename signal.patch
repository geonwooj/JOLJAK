diff --git a/frontend/css/chat.css b/frontend/css/chat.css
index 0c9ebb8..5b5eb2b 100644
--- a/frontend/css/chat.css
+++ b/frontend/css/chat.css
@@ -319,3 +319,145 @@ body {
     opacity: 1;
   }
 }
+
+
+/* AI 진행 상태 패널 */
+.chat-layout {
+  flex: 1 1 auto;
+  min-height: 0;
+  display: flex;
+  overflow: hidden;
+}
+
+.chat-layout .chat {
+  flex: 1 1 auto;
+  min-width: 0;
+}
+
+.signal-panel {
+  width: 320px;
+  flex: 0 0 320px;
+  border-left: 1px solid #e5e7eb;
+  background: #ffffff;
+  padding: 18px 16px;
+  overflow-y: auto;
+}
+
+.signal-panel__header {
+  display: flex;
+  justify-content: space-between;
+  gap: 12px;
+  align-items: flex-start;
+  margin-bottom: 16px;
+}
+
+.signal-panel__header strong {
+  display: block;
+  font-size: 16px;
+  color: #111827;
+}
+
+.signal-panel__header p {
+  margin: 4px 0 0;
+  font-size: 12px;
+  color: #6b7280;
+}
+
+.signal-panel__badge {
+  flex: 0 0 auto;
+  padding: 4px 8px;
+  border-radius: 999px;
+  background: #f3f4f6;
+  color: #374151;
+  font-size: 12px;
+  font-weight: 700;
+}
+
+.signal-panel__badge.is-running {
+  background: #dcfce7;
+  color: #166534;
+}
+
+.signal-panel__badge.is-error {
+  background: #fee2e2;
+  color: #991b1b;
+}
+
+.signal-panel__current {
+  padding: 12px;
+  border-radius: 12px;
+  background: #f9fafb;
+  color: #111827;
+  font-size: 14px;
+  line-height: 1.5;
+  margin-bottom: 16px;
+  border: 1px solid #e5e7eb;
+}
+
+.signal-panel__steps {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+
+.signal-step {
+  display: flex;
+  gap: 10px;
+  align-items: flex-start;
+  color: #9ca3af;
+  font-size: 13px;
+  line-height: 1.45;
+}
+
+.signal-step__dot {
+  width: 18px;
+  height: 18px;
+  margin-top: 1px;
+  border-radius: 50%;
+  border: 2px solid #d1d5db;
+  flex: 0 0 18px;
+  display: grid;
+  place-items: center;
+  font-size: 10px;
+  background: #fff;
+}
+
+.signal-step.is-done {
+  color: #111827;
+}
+
+.signal-step.is-done .signal-step__dot {
+  border-color: #22c55e;
+  background: #22c55e;
+  color: white;
+}
+
+.signal-step.is-current {
+  color: #111827;
+  font-weight: 700;
+}
+
+.signal-step.is-current .signal-step__dot {
+  border-color: #22c55e;
+  border-top-color: transparent;
+  animation: signalSpin 0.8s linear infinite;
+}
+
+.signal-step__code {
+  display: block;
+  font-size: 11px;
+  color: #6b7280;
+  margin-bottom: 2px;
+}
+
+@keyframes signalSpin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+@media (max-width: 1000px) {
+  .signal-panel {
+    display: none;
+  }
+}
